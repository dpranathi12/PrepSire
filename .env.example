# PrepSpire AI Environment Configuration

# Database
# Local SQLite default:
DATABASE_URL=sqlite:///./prepspire.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://user:password@localhost:5432/prepspire

# Security & JWT
SECRET_KEY=prepspire_super_secret_jwt_key_2026_dev_mode_secure
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Dataset Path
DATASET_PATH=./data/interview_forge_v3_complete.csv

# AI Services (Optional Google Gemini or Ollama)
# Leave blank to use built-in Offline Evaluation Engine
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
DEFAULT_EVALUATION_MODE=offline
