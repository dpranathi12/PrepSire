# PrepSpire AI Environment Configuration

# Database
# Local SQLite default:
DATABASE_URL=sqlite:///./prepspire.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://user:password@localhost:5432/prepspire

# Security & JWT
SECRET_KEY=prepspire_super_secret_jwt_key_2026_dev_mode_secure
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Dataset Path
DATASET_PATH=./data/interview_forge_v3_complete.csv

# AI Services Configuration
# Supported DEFAULT_EVALUATION_MODE options:
#  - "ollama"  : Local private LLM inference via Ollama (Recommended: qwen2.5:7b)
#  - "gemini"  : Cloud LLM inference via Google Gemini API
#  - "offline" : Deterministic rule-based evaluation engine (zero external dependencies)
DEFAULT_EVALUATION_MODE=offline

# Google Gemini Configuration
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Ollama Local LLM Configuration
# Download Ollama from https://ollama.com
# Pull your preferred model:
#   ollama pull qwen2.5:7b   (Recommended for interview intelligence)
#   ollama pull llama3:8b
#   ollama pull mistral
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=90
