# ==========================================
# PrepSpire AI - Production Environment Variables
# ==========================================

# 1. Database Configuration
# Local SQLite container volume (default in docker-compose):
DATABASE_URL=sqlite:////app/data/prepspire.db

# Production PostgreSQL (Supabase / Render PostgreSQL):
# Example: postgresql://postgres:YOUR_PASSWORD@db.xxx.supabase.co:5432/postgres
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# 2. Security & JWT
SECRET_KEY=generate_a_long_random_secret_key_for_production_use_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 3. AI Service Configuration
# Google Gemini API (Recommended for Cloud Hosting)
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Default AI Evaluation Mode: "gemini" | "offline" | "ollama"
# Set to "gemini" in production with key, or "offline" for 100% free zero-key operation
DEFAULT_EVALUATION_MODE=offline

# Ollama Local Configuration (optional, if running local LLM alongside)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=90

# 4. CORS Origins (comma-separated domains allowed to call the backend)
CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:80,https://your-frontend-app.onrender.com
